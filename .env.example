# Environment Configuration
NODE_ENV=development
PORT=3000

# Server Configuration
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Game Configuration
TURN_TIMEOUT=10000
MATCH_TIMEOUT=600000
RECONNECT_TIMEOUT=30000

# Database (optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=9ja_chess
DB_USER=postgres
DB_PASSWORD=

# JWT (for authentication)
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=7d

# External Services
API_KEY=
API_URL=
